
from collections import Counter
import re

def parse_log_file(filename):
    ip_addresses = []
    endpoints = []
    error_count = 0
    total_requests = 0
    valid_lines = 0

    try:
        with open(filename, "r") as file:
            for line in file:
                try:
                    parts = line.split()

                    # Check log format
                    if len(parts) < 7:
                        continue

                    ip = parts[0]
                    status = parts[-2]
                    endpoint = parts[6]

                    # Basic validation
                    if not re.fullmatch(r"\d{1,3}(?:\.\d{1,3}){3}", ip):
                        continue

                    if not status.isdigit():
                        continue

                    valid_lines += 1
                    total_requests += 1

                    ip_addresses.append(ip)
                    endpoints.append(endpoint)

                    if int(status) >= 400:
                        error_count += 1

                except (ValueError, IndexError):
                    continue

        print("\n----- LOG FILE ANALYSIS -----")
        print("Total Requests:", total_requests)
        print("Error Responses:", error_count)
        print("Successful/Other Responses:",
              total_requests - error_count)

        print("\nTop 5 IP Addresses:")
        for ip, count in Counter(ip_addresses).most_common(5):
            print(ip, ":", count, "requests")

        print("\nTop 5 Requested Endpoints:")
        for endpoint, count in Counter(endpoints).most_common(5):
            print(endpoint, ":", count, "requests")

        print("\nMalformed Lines:", "Skipped lines")

        # Generate summary report
        with open("summary_report.txt", "w") as report:
            report.write("LOG FILE ANALYSIS REPORT\n")
            report.write("------------------------\n")
            report.write(f"Total Requests: {total_requests}\n")
            report.write(f"Error Responses: {error_count}\n")
            report.write(f"Other Responses: {total_requests-error_count}\n")
            report.write(f"Valid Lines: {valid_lines}\n")

        print("\nSummary report created successfully!")

    except FileNotFoundError:
        print("Error: Log file not found!")


# Main program
parse_log_file("server.log")
